PORT=4000

# Секрет подписи access-токенов. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=

# Время жизни access-токена (формат jsonwebtoken: 15m, 1h, ...)
ACCESS_TOKEN_TTL=15m

# Время жизни refresh-токена в днях
REFRESH_TOKEN_TTL_DAYS=7

# Сколько секунд после ротации старый refresh-токен ещё принимается
# без подозрения на кражу — на случай одновременного обновления из двух вкладок
REFRESH_REUSE_GRACE_SECONDS=10
