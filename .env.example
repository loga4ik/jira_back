PORT=4000

# Секрет подписи access-токенов. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=

# Время жизни access-токена (формат jsonwebtoken: 15m, 1h, ...)
ACCESS_TOKEN_TTL=15m

# Время жизни refresh-токена в днях
REFRESH_TOKEN_TTL_DAYS=7

# Сколько секунд после ротации старый refresh-токен ещё принимается
# без подозрения на кражу — на случай одновременного обновления из двух вкладок
REFRESH_REUSE_GRACE_SECONDS=10

# ---------- база данных ----------
# Локально — по отдельности:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jira
DB_USER=postgres
DB_PASSWORD=
# На хостинге — одной строкой (тогда DB_* выше не нужны) и по TLS:
# DATABASE_URL=postgres://user:password@host:5432/jira
# DB_SSL=true

# ---------- деплой ----------
# Адрес фронтенда, если он на другом домене (через запятую, если несколько).
# В разработке не нужен: Vite проксирует /api.
# CLIENT_ORIGIN=https://jira.example.com
# Сервер за прокси хостинга — число прокси перед ним (обычно 1),
# чтобы ограничение попыток входа видело настоящий IP клиента.
# TRUST_PROXY=1

# ---------- ограничение запросов ----------
# Неудачных попыток входа с одного IP за 15 минут
LOGIN_RATE_LIMIT=10
# Регистраций с одного IP за час
REGISTER_RATE_LIMIT=10
